h1.mb-4.text-2xl.font-bold = category.name
div id="#{dom_id category}" class="w-full flex flex-col rounded border border-gray-200 p-4 shadow-sm"
  p
    strong.text-gray-600 Name:
    =< category.name
  p
    strong.text-gray-600 Code:
    =< category.code
  p
    strong.text-gray-600 Sequence:
    =< category.sequence
  p
    strong.text-gray-600 Is active:
    =< category.is_active
  p
    strong.text-gray-600 Is delete:
    =< category.is_delete
    
  / p.mt-2
  /   = link_to "Detail", category, class: "text-blue-600 hover:underline"
