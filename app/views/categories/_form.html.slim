= form_with(model: category) do |form|
  - if category.errors.any?
    div style="color: red"
      h2 = "#{pluralize(category.errors.count, "error")} prohibited this category from being saved:"
      ul
        - category.errors.each do |error|
          li = error.full_message

  div
    = form.label :name, style: "display: block"
    = form.text_field :name

  div
    = form.label :code, style: "display: block"
    = form.text_field :code

  div
    = form.label :sequence, style: "display: block"
    = form.number_field :sequence

  div
    = form.label :is_active, style: "display: block"
    = form.checkbox :is_active

  div
    = form.label :is_delete, style: "display: block"
    = form.checkbox :is_delete

  div
    = form.submit
