- if notice
  p.mb-4.rounded.bg-green-50.px-4.py-2.text-green-700 = notice

h1.mb-4.text-2xl.font-bold Categories

table#categories.w-full.table-auto.border-collapse
  thead
    tr
      th.border-b.border-gray-200.px-4.py-2.text-left.text-gray-600 Name
      th.border-b.border-gray-200.px-4.py-2.text-left.text-gray-600 Code
      th.border-b.border-gray-200.px-4.py-2.text-left.text-gray-600 Sequence
      th.border-b.border-gray-200.px-4.py-2.text-left.text-gray-600 Is active
      th.border-b.border-gray-200.px-4.py-2.text-left.text-gray-600 Is delete
      th.border-b.border-gray-200.px-4.py-2
  tbody
    - @categories.each do |category|
      tr id="#{dom_id category}"
        td.border-b.border-gray-100.px-4.py-2 = category.name
        td.border-b.border-gray-100.px-4.py-2 = category.code
        td.border-b.border-gray-100.px-4.py-2 = category.sequence
        td.border-b.border-gray-100.px-4.py-2 = category.is_active
        td.border-b.border-gray-100.px-4.py-2 = category.is_delete
        td.border-b.border-gray-100.px-4.py-2
          = link_to "Detail", category, class: "text-blue-600 hover:underline"

= link_to "New category", new_category_path,
  class: "mt-4 inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"
