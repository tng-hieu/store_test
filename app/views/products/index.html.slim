- if notice
  p.mb-4.rounded.bg-green-50.px-4.py-2.text-green-700 = notice

div.flex.items-center.justify-between.mb-4
  h1.text-2xl.font-bold Products
  = link_to "New product", new_product_path,
    class: "inline-block rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700"


- product_rows = @products.map { |product| { id: dom_id(product), cells: [product.name, product.code, product.category&.name, product.sequence, product.is_active], path: product } }

= render "shared/table", headers: ["Name", "Code", "Category", "Sequence", "Is active"], rows: product_rows

= render "shared/pagination", page: @pagy.page, per_page: @pagy.limit, total_count: @pagy.count

